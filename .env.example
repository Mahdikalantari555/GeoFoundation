# GeoFoundation Gateway — environment template
# Copy to `.env` and fill in. Server-side secrets only — never commit the real file.
# (Root .gitignore excludes .env.)

# ── LLM (hybrid: remote OpenAI-compatible API by default, local GGUF fallback)
# Name of the env var that holds the provider API key. The gateway reads the KEY
# from this env var at runtime — the key is NEVER accepted from clients or stored.
GEOMEMORY_LLM_API_KEY=
# Env var name the workspace setting `llm_api_key_env` resolves to (default below).
# GEOMEMORY_LLM_API_KEY_ENV=GEOMEMORY_LLM_API_KEY
# OpenAI-compatible base URL (optional; omit for the provider default).
# GEOMEMORY_LLM_API_BASE_URL=https://api.openai.com/v1
# Model id used when the workspace does not override it.
# GEOMEMORY_LLM_MODEL_ID=gpt-4o-mini

# ── Qdrant (optional; only when vector_backend=qdrant)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ── Gateway
# Host/port for `uvicorn geofront_api.main:app`
# GEOMEMORY_HOST=0.0.0.0
# GEOMEMORY_PORT=8000
# Log level: DEBUG | INFO | WARNING | ERROR
# GEOMEMORY_LOG_LEVEL=INFO
